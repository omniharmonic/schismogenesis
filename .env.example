# Copy to .env (git-ignored). Local development values only.
PG_PASSWORD=arena-dev-only
ARENA_PROFILE=cloud-dev
ARENA_PG_PORT=5544
# The real database. Neon in normal use; the local Docker address also works.
ARENA_DATABASE_URL=postgresql+psycopg://arena:arena-dev-only@localhost:5544/arena
# Disposable local server for tests, which drop and recreate a database. Never point at Neon.
ARENA_TEST_DATABASE_URL=postgresql+psycopg://arena:arena-dev-only@localhost:5544/arena
ARENA_SOURCE_DIR=data/sources
